# Copie para .env.local para desenvolvimento local (nunca commitar valores reais).
# Em produção (Easypanel), configure estas mesmas chaves no painel de
# variáveis de ambiente do app.

# --- Client-side (prefixo VITE_) ---
# Precisam existir em tempo de BUILD (o Vite as embute no bundle estático).
# Mudou o valor? É preciso REBUILD (não só reiniciar o container).

# URL pública do site, usada no canonical/og:url.
VITE_SITE_URL=https://lp.conexiia.com.br

# Site key do reCAPTCHA v3 (público, visível no HTML da página).
VITE_RECAPTCHA_SITE_KEY=

# Pixel ID da Meta (público, visível no código de qualquer site com o pixel instalado).
VITE_FACEBOOK_PIXEL_ID=

# --- Server-only (nunca exposto ao navegador) ---
# Só precisam existir em tempo de EXECUÇÃO (um restart do container já basta).

# Secret key do reCAPTCHA v3, usada para validar o token no servidor.
RECAPTCHA_SECRET_KEY=

# Access token da Conversions API (Meta Events Manager > Configurações > Conversions API).
FACEBOOK_CAPI_ACCESS_TOKEN=

# URL do webhook que recebe os leads do formulário (n8n).
WEBHOOK_URL=

# Token compartilhado enviado no header Authorization ao chamar o webhook acima.
WEBHOOK_TOKEN=
